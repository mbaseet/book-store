{
  "name": "personalized-storybooks-eg",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personalized-storybooks-eg-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "env": {
    "staging": {
      "preview_urls": false,
      "workers_dev": true,
      "vars": {
        "APP_BASE_URL": "https://personalized-storybooks-eg-staging.mint-meow.workers.dev",
        "ENVIRONMENT": "production",
        "PASSWORD_HASH_ITERATIONS": "5000"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "personalized-storybooks-eg-staging-db",
          "database_id": "199de385-a579-419a-bc84-675ee17a6f7c",
          "migrations_dir": "drizzle"
        }
      ],
      "triggers": {
        "crons": ["*/15 * * * *"]
      }
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
