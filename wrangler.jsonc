{
  "name": "personalized-storybooks-eg",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personalized-storybooks-eg-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "env": {
    "staging": {
      "account_id": "c8aea16544af3ad32a67f6c3e0217755",
      "preview_urls": false,
      "workers_dev": true,
      "vars": {
        "APP_BASE_URL": "https://personalized-storybooks-eg-staging.m-baseeto.workers.dev",
        "ENVIRONMENT": "production",
        "PASSWORD_HASH_ITERATIONS": "5000"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "personalized-storybooks-eg-staging-db",
          "database_id": "7eab0c22-b9de-4f0f-842e-8f9c1d8f5cb8",
          "migrations_dir": "drizzle"
        }
      ],
      "triggers": {
        "crons": ["*/15 * * * *"]
      }
    },
    "production": {
      "account_id": "c8aea16544af3ad32a67f6c3e0217755",
      "preview_urls": false,
      "workers_dev": false,
      "routes": [
        {
          "pattern": "mintmeow.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "APP_BASE_URL": "https://mintmeow.com",
        "ENVIRONMENT": "production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "personalized-storybooks-eg-production-db",
          "database_id": "d71121a2-d077-4b5b-b432-8008974501b0",
          "migrations_dir": "drizzle"
        }
      ]
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
